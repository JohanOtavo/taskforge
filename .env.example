# --- Base de datos ---------------------------------------------------------
# Pooled (PgBouncer / Supavisor / Neon -pooler). La usa Prisma.
# En un pooler en modo transaccion anade: ?pgbouncer=true&connection_limit=5
DATABASE_URL="postgresql://taskforge:taskforge@localhost:55432/taskforge?schema=public"

# Conexion DIRECTA en modo sesion (puerto 5432, sin pooler).
# Obligatoria: LISTEN/NOTIFY no funciona a traves de un pooler transaccional,
# y `prisma migrate` tambien la necesita. Si apuntas ambas al pooler, el
# tiempo real deja de funcionar EN SILENCIO.
DATABASE_URL_DIRECT="postgresql://taskforge:taskforge@localhost:55432/taskforge?schema=public"

# --- App -------------------------------------------------------------------
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Node fuerza maxmem=32MB en scrypt; el coste OWASP necesita ~128MiB.
# Subir el pool de libuv evita que 5 logins simultaneos bloqueen el proceso.
UV_THREADPOOL_SIZE="8"

# --- Solo para instancias pequenas (512 MiB) -------------------------------
# Por defecto el hash de contrasena usa el coste de OWASP (N=2^17, ~128 MiB)
# y permite 2 hashes a la vez: 256 MiB de pico, mas de lo que tiene una
# instancia gratuita. Estas dos variables bajan el pico a ~64 MiB.
# Solo se puede BAJAR N, y solo a una potencia de dos >= 2^14. Los parametros
# viajan dentro de cada hash, asi que cambiarlo no invalida las contrasenas
# existentes: al mover la app a una instancia mayor, borra las dos lineas.
# SCRYPT_N="65536"
# PASSWORD_HASH_CONCURRENCY="1"
