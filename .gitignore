# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Plantillas y entorno de test SI se versionan: sin ellos nadie puede
# levantar el proyecto ni correr los tests de integracion.
!.env.example
!.env.test

# vercel
.vercel

# configuracion local del editor/agente
.claude

# typescript
*.tsbuildinfo
next-env.d.ts

# cobertura
coverage/
